PORT=3000
# Required for PUT /api/state in production. In development, defaults to dev-demo-secret if unset.
ADMIN_SECRET=change-me
# Optional. Overrides DEFAULT_JARVIS_PERSONALITY in server.mjs for extra Jarvis instructions (code-only; no UI).
# JARVIS_PERSONALITY=Stay brief and friendly.
# In production, admin.html is blocked unless you set:
# ENABLE_ADMIN_UI=true
