PORT=3000
# Required for PUT /api/state in production. In development, defaults to dev-demo-secret if unset.
ADMIN_SECRET=change-me
# Optional. Overrides DEFAULT_JARVIS_PERSONALITY in server/state.mjs for extra Jarvis instructions (code-only; no UI).
# JARVIS_PERSONALITY=Stay brief and friendly.
# Optional. Full URL of the Home Assistant webhook that toggles the physical lights.
# LIGHTS_WEBHOOK_URL=http://127.0.0.1:8123/api/webhook/my_secret_webhook_123
# Optional. HA webhooks for blinds (separate open/close actions).
# BLINDS_OPEN_WEBHOOK_URL=http://127.0.0.1:8123/api/webhook/openblinds
# BLINDS_CLOSE_WEBHOOK_URL=http://127.0.0.1:8123/api/webhook/closeblinds
# Optional. If set, lights webhooks SSH to this host and run curl there (for HA that only responds to localhost).
# Requires passwordless SSH key auth.
# LIGHTS_SSH_HOST=jack@100.93.144.25
# Optional. Same as LIGHTS_SSH_HOST but for blinds webhooks only. If unset, blinds reuse LIGHTS_SSH_HOST when that is set.
# BLINDS_SSH_HOST=user@other-host
# In production, admin.html is blocked unless you set:
# ENABLE_ADMIN_UI=true

# Google Calendar (server): calendar ID and path to the service account JSON key.
# GOOGLE_CALENDAR_ID=primary
# Absolute path, or path relative to the repo root. GOOGLE_APPLICATION_CREDENTIALS is also accepted if unset.
# GOOGLE_CALENDAR_KEY_FILE=./google-calendar-service-account.json
