PORT=3000
# Required for PUT /api/state in production. In development, defaults to dev-demo-secret if unset.
ADMIN_SECRET=change-me
# Optional. Overrides DEFAULT_JARVIS_PERSONALITY in server.mjs for extra Jarvis instructions (code-only; no UI).
# JARVIS_PERSONALITY=Stay brief and friendly.
# Optional. Full URL of the Home Assistant webhook that toggles the physical lights.
# LIGHTS_WEBHOOK_URL=http://127.0.0.1:8123/api/webhook/my_secret_webhook_123
# Optional. HA webhooks for blinds (separate open/close actions).
# BLINDS_OPEN_WEBHOOK_URL=http://127.0.0.1:8123/api/webhook/openblinds
# BLINDS_CLOSE_WEBHOOK_URL=http://127.0.0.1:8123/api/webhook/closeblinds
# Optional. If set, the server SSHs into this host and runs curl there (for HA that only responds to localhost).
# Used for both lights and blinds webhooks. Requires passwordless SSH key auth.
# LIGHTS_SSH_HOST=jack@100.93.144.25
# In production, admin.html is blocked unless you set:
# ENABLE_ADMIN_UI=true
